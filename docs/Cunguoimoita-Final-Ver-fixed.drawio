<mxfile host="app.diagrams.net" scale="1" border="0">
  <diagram id="pSORpaaTeRwGm7PbQ1ig" name="Final-Ver-fixed">
    <mxGraphModel dx="7740" dy="4970" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% =====================================================================\n%% cunguoimoita.com — Class Diagram (bản tối giản theo góp ý giảng viên)\n%% Giữ nguyên class &amp; thuộc tính trong bản vẽ; chỉ bổ sung quan hệ.\n%% Thuộc tính có dấu \&quot;/\&quot; là thuộc tính dẫn xuất.\n%% =====================================================================\nclassDiagram\ndirection TB\n\n%% ============================ NGƯỜI DÙNG ============================\nclass Guest {\n  -String sessionId\n  +browseProduct() List~Product~\n  +searchProduct(keyword) List~Product~\n  +viewCategory() List~Category~\n  +register() Customer\n}\n\nclass User {\n  &lt;&lt;abstract&gt;&gt;\n  #String id\n  #String fullname\n  #String email\n  #String passwordHash\n  #String phone\n  #String avatarUrl\n  #int /ecoPoints\n  #Date joinDate\n  #enum status [active, banned]\n  #String userRole\n  +register() void\n  +login() boolean\n  +logout() void\n  +updateProfile() void\n  +viewProfile() Profile\n  +verifyPassword(String input) boolean\n}\n\nclass Admin {\n  -int permissionLevel\n  +banUser(userId) void\n  +approveProduct(productId) void\n  +manageCategory() void\n  +resolveDispute(disputeId, decision) void\n  +managePartner() void\n  +manageMemberTier() void\n}\n\nclass Customer {\n  -String tierId\n  -boolean isPhoneVerified\n  -String payoutAccountRef\n  -float /avgRating\n  -int /totalSales\n  -int /totalSwaps\n  -double /outstandingDebt\n  -int /codRefusalCount\n  +postProduct() Product\n  +checkout() Order\n  +confirmReceived(transactionId) void\n  +raiseDispute(transactionId) Dispute\n  +canUseCod() boolean\n  +rateUser(targetId, rating) void\n  +addToWishlist() void\n}\n\nclass Address {\n  -String label\n  -String street\n  -String ward\n  -String district\n  -String city\n  -boolean isDefault\n  +addAddress() void\n  +updateAddress() void\n  +setDefault() void\n}\n\nclass MemberTier {\n  -String id\n  -enum name [Bronze, Silver, Gold, Diamond]\n  -int minEcoPoints\n  -float discountRate\n  -String benefitNote\n}\n\nclass Notification {\n  -String id\n  -String userId\n  -enum type [order, payment, shipment, review, system]\n  -String content\n  -String linkUrl\n  -boolean isRead\n  -Date createdDate\n  +send() void\n  +markAsRead() void\n}\n\n%% ============================ SẢN PHẨM ============================\nclass Category {\n  -String id\n  -String name\n  -String description\n  -String parentCategoryId\n  +addCategory() void\n  +getSubcategories() List~Category~\n}\n\nclass Product {\n  -String id\n  -String name\n  -String description\n  -String[] images\n  -enum listingType [sale, swap, both]\n  -double price\n  -double estimatedValue\n  -String desiredExchangeNote\n  -enum condition [mới, cũ, hỏng nhẹ]\n  -boolean acceptCod\n  -enum verifiedStatus [unverified, verified_by_partner, rejected]\n  -enum status [draft, available, reserved, sold, exchanged, hidden]\n  -Date postedDate\n  +create() void\n  +update() void\n  +delete() void\n  +changeStatus(newStatus) void\n  +reserve() void\n  +markSold() void\n  +suggestMatches() List~Product~\n}\n\nclass Wishlist {\n  -String id\n  -List~Product~ products\n  -Date addedDate\n  +add() void\n  +remove() void\n}\n\nclass Review {\n  -String id\n  -String orderId\n  -String authorId\n  -String targetUserId\n  -int rating\n  -String content\n  -Date createdDate\n  +create() void\n  +delete() void\n}\n\nclass Report {\n  -String id\n  -String reporterId\n  -enum targetType [product, user]\n  -String targetId\n  -enum reason [scam, fake_item, prohibited_item, spam, other]\n  -String description\n  -String[] evidenceImages\n  -enum status [pending, resolved, rejected]\n  -Date createdDate\n  -String handledByAdminId\n  +create() void\n  +resolve(action) void\n}\n\n%% ============================ MUA HÀNG ============================\nclass Cart {\n  -String id\n  -String ownerId\n  -Date createdDate\n  +addItem() void\n  +removeItem() void\n  +clearCart() void\n  +checkout() Order\n}\n\nclass CartItem {\n  -String id\n  -String cartId\n  -String productId\n  -int quantity\n}\n\nclass Order {\n  -String id\n  -String code\n  -String buyerId\n  -String sellerId\n  -String shippingAddressId\n  -String voucherId\n  -enum paymentMethod [online, cod]\n  -double subTotal\n  -double shippingFee\n  -double discountAmount\n  -double totalAmount\n  -enum status [new, awaiting_payment, paid, shipping, delivered, completed, cancelled, refunded]\n  -Date orderDate\n  -Date completedDate\n  +chooseAddress(addressId) void\n  +chooseCarrier(carrierId) Shipment\n  +choosePaymentMethod(method) void\n  +applyVoucher(code) void\n  +confirmShipped() void\n  +confirmReceived() void\n  +calculateTotal() double\n  +complete() void\n  +cancel(reason) void\n}\n\nclass OrderItem {\n  -String id\n  -String orderId\n  -String productId\n  -int quantity\n  -double unitPrice\n}\n\nclass Voucher {\n  -String id\n  -String code\n  -String customerId\n  -double discountValue\n  -double minOrderValue\n  -enum status [issued, used, expired]\n  -Date issuedDate\n  -Date expiryDate\n  +checkValidity() boolean\n  +redeem(orderId) void\n}\n\n%% ============================ THANH TOÁN ============================\nclass Payment {\n  -String id\n  -String code\n  -String orderId\n  -String payerId\n  -double amount\n  -enum gateway [vnpay, momo, bank_transfer]\n  -String gatewayTxnId\n  -enum status [pending, paid, failed, refunded]\n  -DateTime createdAt\n  -DateTime paidAt\n  +process() void\n  +handleCallback(result) void\n  +markPaid() void\n  +markFailed(reason) void\n  +refund(reason) void\n}\n\nclass Payout {\n  -String id\n  -String orderId\n  -String sellerId\n  -double grossAmount\n  -double commissionFee\n  -double netAmount\n  -enum method [bank_transfer, ewallet]\n  -enum status [scheduled, done, failed]\n  -Date payoutDate\n  +calculateNet() double\n  +execute() void\n}\n\nclass Refund {\n  -String id\n  -String orderId\n  -String paymentId\n  -String buyerId\n  -double amount\n  -enum reason [cancelled, not_received, wrong_item, dispute_won]\n  -enum status [pending, done, failed]\n  -Date refundDate\n  +execute() void\n}\n\nclass Dispute {\n  -String id\n  -String orderId\n  -String raisedById\n  -String againstId\n  -enum reason [not_received, wrong_item, damaged, fake, other]\n  -String description\n  -String[] evidenceImages\n  -enum status [open, reviewing, resolved_refund, resolved_payout, rejected]\n  -Date createdDate\n  -Date resolvedDate\n  -String handledByAdminId\n  -String resolutionNote\n  +open() void\n  +submitEvidence(images) void\n  +resolve(decision, note) void\n}\n\n%% ============================ VẬN CHUYỂN ============================\nclass ShippingCarrier {\n  -String id\n  -String name\n  -String logoUrl\n  -String hotline\n  -double baseFee\n  -int estimatedDays\n  -boolean isActive\n  +calculateFee(fromCity, toCity) double\n}\n\nclass Shipment {\n  -String id\n  -String orderId\n  -String carrierId\n  -String trackingCode\n  -double shippingFee\n  -enum status [created, picked_up, in_transit, delivered, returned]\n  -Date createdDate\n  -Date deliveredDate\n  -double codAmount\n  -enum codStatus [none, pending, collected, remitted]\n  -DateTime codCollectedAt\n  -DateTime codRemittedAt\n  +updateStatus(newStatus) void\n  +track() String\n  +confirmCodCollected() void\n  +confirmCodRemitted() void\n}\n\n%% ============================ TIN NHẮN ============================\nclass Conversation {\n  -String id\n  -String productId\n  -String askerId\n  -String sellerId\n  -enum status [open, closed]\n  -DateTime createdAt\n  -DateTime lastMessageAt\n  +start() void\n  +sendMessage(content) Message\n  +markAllRead() void\n  +close() void\n}\n\nclass Message {\n  -String id\n  -String conversationId\n  -String senderId\n  -enum type [text, image]\n  -String content\n  -DateTime sentAt\n  -boolean isRead\n  +send() void\n  +markAsRead() void\n}\n\n%% ============================ QUAN HỆ ============================\n%% --- Kế thừa ---\nUser &lt;|-- Admin\nUser &lt;|-- Customer\n\n%% --- Guest (chưa đăng nhập) ---\nGuest ..&gt; Product : «views»\nGuest ..&gt; Category : «views»\nGuest ..&gt; Customer : «create»\n\n%% --- Người dùng ---\nCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Address : sở hữu\nCustomer \&quot;0..*\&quot; --&gt; \&quot;1\&quot; MemberTier : thuộc hạng\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notification : nhận\nAdmin ..&gt; MemberTier : quản lý\n\n%% --- Sản phẩm ---\nCategory \&quot;0..1\&quot; &lt;-- \&quot;0..*\&quot; Category : là danh mục con của\nProduct \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Category : classifies\nCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Product : đăng bán\nAdmin \&quot;0..1\&quot; ..&gt; \&quot;0..*\&quot; Product : duyệt\nCustomer \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Wishlist : sở hữu\nWishlist \&quot;0..*\&quot; o-- \&quot;0..*\&quot; Product : lưu\n\n%% --- Giỏ hàng &amp; đơn hàng ---\nCustomer \&quot;1\&quot; --&gt; \&quot;1\&quot; Cart : sở hữu\nCart \&quot;1\&quot; *-- \&quot;0..*\&quot; CartItem : chứa\nCartItem \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Product : tham chiếu\nCart ..&gt; Order : checkout tạo (tách theo người bán)\nCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Order : mua (buyer)\nCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Order : bán (seller)\nOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem : gồm\nOrderItem \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Product : tham chiếu\nOrder \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Address : giao đến\nCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Voucher : sở hữu\nOrder \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Voucher : áp dụng\n\n%% --- Thanh toán ---\nOrder \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Payment : được thanh toán bởi\nPayment \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer : người trả\nOrder \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Payout : giải ngân\nPayout \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer : người bán nhận\nOrder \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Refund : hoàn tiền\nRefund \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Payment : hoàn từ (null nếu COD)\nRefund \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer : người mua nhận\n\n%% --- Vận chuyển ---\nOrder \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Shipment : được giao bởi\nShipment \&quot;0..*\&quot; --&gt; \&quot;1\&quot; ShippingCarrier : thực hiện\n\n%% --- Khiếu nại, đánh giá, báo cáo ---\nOrder \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Dispute : bị khiếu nại\nDispute \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer : người mở\nDispute \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer : bị khiếu nại\nAdmin \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Dispute : xử lý\nDispute ..&gt; Refund : resolved_refund\nDispute ..&gt; Payout : resolved_payout\nOrder \&quot;1\&quot; --&gt; \&quot;0..2\&quot; Review : được đánh giá\nReview \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer : tác giả\nReview \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer : người được đánh giá\nCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Report : gửi\nReport ..&gt; Product : target (product)\nReport ..&gt; Customer : target (user)\nAdmin \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Report : xử lý\n\n%% --- Tin nhắn ---\nConversation \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Product : hỏi về\nConversation \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer : người hỏi (asker)\nConversation \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer : người bán (seller)\nConversation \&quot;1\&quot; *-- \&quot;0..*\&quot; Message : chứa\nMessage \&quot;0..*\&quot; --&gt; \&quot;1\&quot; User : người gửi&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Yw5MYm3tVkKkXBbsKact-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
