        <mxCell id="CVxx0mKpjxUJD8uBBbGQ-5" parent="CVxx0mKpjxUJD8uBBbGQ-4" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p style=&quot;text-align: justify;&quot;&gt; &lt;strong&gt;Association —&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;text-align: justify;&quot;&gt;  &quot;Người mua và người bán trong một cuộc trò chuyện — họ liên quan tới nhau qua cuộc chat, nhưng mỗi người vẫn tồn tại độc lập dù cuộc chat kết thúc.&quot;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;text-align: justify;&quot;&gt; &lt;strong&gt;Aggregation —◇&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;text-align: justify;&quot;&gt;  &quot;Một lớp học &quot;có&quot; nhiều học sinh. Nếu lớp học giải tán, học sinh đó vẫn tồn tại chuyển sang lớp khác.&quot;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;text-align: justify;&quot;&gt; &lt;strong&gt;Composition ◆—&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;text-align: justify;&quot;&gt;  &quot;Một cái đơn hàng &quot;có&quot; các dòng sản phẩm trong đơn (order item). Nếu xoá đơn hàng, các dòng đó cũng mất theo — chúng không tồn tại tách rời khỏi đơn hàng.&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="232" width="311" x="6" y="27" as="geometry" />
        </mxCell>
      </root>
