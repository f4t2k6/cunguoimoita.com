        <mxCell id="CVxx0mKpjxUJD8uBBbGQ-3" parent="CVxx0mKpjxUJD8uBBbGQ-2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p&gt;+ public&lt;/p&gt;&lt;p&gt;- private&lt;/p&gt;&lt;p&gt;# protected&lt;/p&gt;&lt;p&gt;~ package/default&lt;/p&gt;" vertex="1">
