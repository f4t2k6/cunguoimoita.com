        <mxCell id="CVxx0mKpjxUJD8uBBbGQ-4" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Kí hiệu mối quan hệ" vertex="1">
          <mxGeometry height="261" width="317" x="-1114" y="-335" as="geometry" />
